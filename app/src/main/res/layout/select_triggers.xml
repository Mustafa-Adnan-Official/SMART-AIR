<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/outline_button">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Triggers"
        android:textSize="19sp"
        android:textStyle="bold"
        android:fontFamily="@font/codec_pro_fixed"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:background="@drawable/dark_button_bg"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/very_light_grey_bg">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/codec_pro_fixed"
            android:text="Dust Mites"
            android:textColor="#000000"
            android:textSize="17sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id = "@+id/switch_dustmite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_colors"
            app:trackTint="@color/switch_track_colors"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/very_light_grey_bg">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pets"
            android:textSize="17sp"
            android:fontFamily="@font/codec_pro_fixed"
            android:textStyle="bold"
            android:textColor="#000000"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id = "@+id/switch_pets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_colors"
            app:trackTint="@color/switch_track_colors"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/very_light_grey_bg">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Smoke"
            android:fontFamily="@font/codec_pro_fixed"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#000000"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id = "@+id/switch_smoke"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_colors"
            app:trackTint="@color/switch_track_colors"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/very_light_grey_bg">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/codec_pro_fixed"
            android:layout_weight="1"
            android:text="Strong Odors/ Perfumes"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#000000"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_odors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_colors"
            app:trackTint="@color/switch_track_colors"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/very_light_grey_bg">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/codec_pro_fixed"
            android:layout_weight="1"
            android:text="Cold Air"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#000000"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id = "@+id/switch_coldair"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_colors"
            app:trackTint="@color/switch_track_colors"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/very_light_grey_bg">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Illness"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="@font/codec_pro_fixed"
            android:textColor="#000000"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id = "@+id/switch_illness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_colors"
            app:trackTint="@color/switch_track_colors"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/very_light_grey_bg">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Exercise"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="@font/codec_pro_fixed"
            android:textColor="#000000"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id = "@+id/switch_exercise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_colors"
            app:trackTint="@color/switch_track_colors"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/dark_button_bg"
            android:backgroundTint="@null"
            android:fontFamily="@font/codec_pro_fixed"
            android:text="Next"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/dark_button_bg"
            android:backgroundTint="@null"
            android:fontFamily="@font/codec_pro_fixed"
            android:text="Back"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>

