<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    >

    <ImageButton
        android:id="@+id/inventory_exit_button"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="start"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:scaleType="fitCenter"
        android:layout_marginBottom="10dp"
        android:contentDescription="Exit"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation = "horizontal"
        android:showDividers="middle"
        >
    <Button
        android:id="@+id/inventory_controller_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Controller"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:fontFamily="@font/codec_pro_regular"
        android:layout_marginBottom="16dp"
        android:background = "@drawable/inventory_toggle_bg"
        android:layout_marginRight="10dp"

        />

        <Button
            android:id="@+id/inventory_rescue_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Rescue"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:fontFamily="@font/codec_pro_regular"
            android:layout_marginBottom="16dp"
            android:background = "@drawable/inventory_toggle_bg"
            android:layout_marginLeft = "10dp"

            />
    </LinearLayout>
    <LinearLayout
        android:layout_width = "match_parent"
        android:layout_height = "wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom = "5dp"
        android:padding="10dp"
        android:showDividers="middle"

        >


        <TextView
            android:id="@+id/purchase_date_text"
            android:layout_width = "match_parent"
            android:layout_height = "wrap_content"
            android:layout_weight="1"
            android:text = "Purchase Date: 26/12/2024"
            android:padding = "10dp"
            android:layout_marginBottom="10dp"
            android:textSize="18sp"
            android:layout_centerVertical="true"
            android:fontFamily = "@font/codec_pro_regular"
            android:background = "@drawable/rounded_settings_background"


            />

        <TextView
            android:id="@+id/expiration_date_text"
            android:layout_width = "match_parent"
            android:layout_height = "wrap_content"
            android:layout_weight="1"
            android:text = "Expiration Date: 13/11/2027"
            android:padding = "10dp"
            android:layout_marginBottom="10dp"
            android:textSize="18sp"
            android:layout_centerVertical="true"
            android:fontFamily = "@font/codec_pro_regular"
            android:background = "@drawable/rounded_settings_background"


            />

        <TextView
            android:id="@+id/inventory_daily_uses_text"
            android:layout_width = "match_parent"
            android:layout_height = "wrap_content"
            android:layout_weight="1"
            android:text = "Expected Daily Controller Uses: 0"
            android:padding = "10dp"
            android:textSize="18sp"
            android:layout_centerVertical="true"
            android:layout_marginBottom="10dp"
            android:fontFamily = "@font/codec_pro_regular"
            android:background = "@drawable/rounded_settings_background"



            />

        <TextView
            android:id="@+id/inventory_amount_left_text"
            android:layout_width = "match_parent"
            android:layout_height = "wrap_content"
            android:layout_weight="1"
            android:text = "Amount Left: 100%"
            android:padding = "10dp"
            android:textSize="18sp"
            android:layout_centerVertical="true"
            android:layout_marginBottom="10dp"
            android:fontFamily = "@font/codec_pro_regular"
            android:background = "@drawable/rounded_settings_background"



            />

    </LinearLayout>




    <Button
        android:id="@+id/inventory_new_canister_button"
        android:layout_width="match_parent"
        android:layout_weight = "1"
        android:layout_height="40dp"
        android:background="@drawable/rounded_managedata_background"
        android:fontFamily="@font/codec_pro_regular"
        android:text="New Canister"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/inventory_warning_text"
        android:layout_width = "match_parent"
        android:layout_height = "wrap_content"
        android:layout_weight="1"
        android:text = "! Warning: Creating a New Canister will replace current canister displayed information.
Track only one canister per inventory type at a time!"
        android:padding = "10dp"
        android:textColor = "@android:color/holo_red_dark"
        android:textSize="10sp"
        android:layout_centerVertical="true"
        android:layout_marginBottom="10dp"
        android:fontFamily = "@font/codec_pro_regular"



        />





</LinearLayout>