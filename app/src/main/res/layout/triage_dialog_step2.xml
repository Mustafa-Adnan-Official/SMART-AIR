<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- TOP BAR WITH LOGO -->
    <ImageView
        android:id="@+id/triageTopBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#142144"
        android:scaleType="fitCenter"
        android:src="@drawable/smartair_official2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/cardStep2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/triage_card_bg"
        android:padding="16dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/triageTopBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- RED TRIAGE LABEL -->
        <TextView
            android:id="@+id/textTriageLabelStep2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TRIAGE STEP 2 — follow these instructions."
            android:textColor="#D42828"
            android:textStyle="bold"
            android:textSize="14sp"
            android:gravity="center"
            android:fontFamily="@font/garet_heavy"
            android:layout_marginBottom="8dp" />

        <!-- Red title -->
        <TextView
            android:id="@+id/textStep2Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PLEASE ADHERE TO THE FOLLOWING STEPS:"
            android:textAlignment="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FF0000"
            android:fontFamily="@font/garet_heavy"/>

        <!-- Bullet list -->
        <TextView
            android:id="@+id/textInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="• Use rescue inhaler (2–4 puffs)\n• Continue daily medication\n• Avoid triggers strictly"
            android:textSize="14sp"
            android:textColor="#000000"
            android:fontFamily="@font/garet_book"/>

        <!-- Rescue section -->
        <TextView
            android:id="@+id/textRescueTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="RESCUE INHALER:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:fontFamily="@font/garet_heavy"/>

        <TextView
            android:id="@+id/textRescueSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Actuations/Puffs or measures?"
            android:textSize="12sp"
            android:textColor="#000000"
            android:fontFamily="@font/garet_book"/>

        <LinearLayout
            android:id="@+id/layoutRescueCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/textRescueCount"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:background="@drawable/triage_counter_bg"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/garet_heavy"/>

            <Button
                android:id="@+id/buttonRescuePlus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:layout_marginStart="8dp"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:background="@drawable/triage_plusminus_bg"
                android:text="+"
                android:textAllCaps="false"
                android:textColor="#142144"
                android:textSize="18sp" />

            <Button
                android:id="@+id/buttonRescueMinus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:layout_marginStart="8dp"
                android:background="@drawable/triage_plusminus_bg"
                android:text="-"
                android:textAllCaps="false"
                android:textColor="#142144"
                android:textSize="18sp"
                android:fontFamily="@font/garet_heavy"/>
        </LinearLayout>

        <!-- Controller section -->
        <TextView
            android:id="@+id/textControllerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="CONTROLLER:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:fontFamily="@font/garet_heavy"/>

        <TextView
            android:id="@+id/textControllerSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Actuations/Puffs or measures?\n Use only if rescue inhaler is not available"
            android:textSize="12sp"
            android:textColor="#000000"
            android:fontFamily="@font/garet_book"/>

        <LinearLayout
            android:id="@+id/layoutControllerCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/textControllerCount"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:background="@drawable/triage_counter_bg"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/garet_heavy"/>

            <Button
                android:id="@+id/buttonControllerPlus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:background="@drawable/triage_plusminus_bg"
                android:text="+"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:textAllCaps="false"
                android:textColor="#142144"
                android:textSize="18sp" />

            <Button
                android:id="@+id/buttonControllerMinus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:background="@drawable/triage_plusminus_bg"
                android:text="-"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:textAllCaps="false"
                android:textColor="#142144"
                android:textSize="18sp"
                android:fontFamily="@font/garet_heavy"/>
        </LinearLayout>

        <!-- Timer -->
        <TextView
            android:id="@+id/textTimer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/triage_timer_bg"
            android:gravity="center"
            android:text="9:59"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:fontFamily="@font/garet_heavy"/>

        <!-- Button row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/buttonBackStep2"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/dark_button_bg"
                android:text="BACK"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/garet_book"/>

            <Button
                android:id="@+id/buttonNextStep2"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/dark_button_bg"
                android:text="NEXT"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/garet_book"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
