<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- Top Logo Bar (Image + Gear Icon) -->
        <ImageView
            android:id="@+id/logoSmartAir"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="#142144"
            android:src="@drawable/actual_logo"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/settings_gear"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:scaleType="fitCenter"
            android:padding="8dp"
            app:layout_constraintTop_toTopOf="@id/logoSmartAir"
            app:layout_constraintBottom_toBottomOf="@id/logoSmartAir"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="12dp" />

        <!-- Profile Section -->
        <LinearLayout
            android:id="@+id/profile_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="24dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/logoSmartAir"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Profile Picture Button -->
            <ImageButton
                android:id="@+id/btn_profile_picture"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/profile_picture_border"
                android:scaleType="centerCrop"
                android:contentDescription="Profile Picture" />

            <!-- Greeting Text -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/text_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hello"
                    android:textSize="18sp"
                    android:textColor="#757575"
                    android:fontFamily="@font/garet_book" />

                <TextView
                    android:id="@+id/text_child_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Child Name"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:fontFamily="@font/garet_heavy" />

            </LinearLayout>

        </LinearLayout>

        <!-- Today's PEF Zone Banner (NOT a button) -->
        <LinearLayout
            android:id="@+id/banner_pef_zone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/pef_zone_background"
            android:padding="24dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/profile_section"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/text_pef_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today's PEF Zone"
                android:textSize="14sp"
                android:textColor="#000000"
                android:fontFamily="@font/codec_pro_regular"
                android:background="@drawable/outline_button"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/text_pef_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="82% PEF"
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_gravity="center"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/codec_pro_fixed" />

            <TextView
                android:id="@+id/text_pef_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="of PB"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:layout_gravity="center"
                android:fontFamily="@font/codec_pro_regular" />

        </LinearLayout>

        <!-- View History and Streaks Row -->
        <LinearLayout
            android:id="@+id/row_history_streaks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:weightSum="2"
            app:layout_constraintTop_toBottomOf="@id/banner_pef_zone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- View History BUTTON -->
            <Button
                android:id="@+id/btn_view_history"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/dark_button_bg"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:text="View History\n📅"
                android:textAllCaps="false"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:fontFamily="@font/codec_pro_regular" />

            <!-- Streaks Banner (display only) -->
            <LinearLayout
                android:id="@+id/banner_streaks"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:background="@drawable/dark_button_bg"
                android:padding="16dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textSize="24sp"
                        android:textColor="#4CAF50"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/text_controller_streak"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CONTROLLER STREAK: # DAYS"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:fontFamily="@font/codec_pro_regular" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📋"
                        android:textSize="24sp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/text_technique_streak"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TECHNIQUE STREAK: # DAYS"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:fontFamily="@font/codec_pro_regular" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Daily Check-In BUTTON -->
        <Button
            android:id="@+id/btn_daily_checkin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/daily_checkin_background"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:padding="16dp"
            android:text="Click for daily check-in\nDAILY-CHECK IN"
            android:textAllCaps="false"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:fontFamily="@font/codec_pro_fixed"
            app:layout_constraintTop_toBottomOf="@id/row_history_streaks"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Having Trouble Breathing Button -->
        <Button
            android:id="@+id/btn_trouble_breathing"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:text="Having Trouble\nBreathing?"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:background="@drawable/dark_button_bg"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:fontFamily="@font/codec_pro_fixed"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/btn_daily_checkin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Medicine Buttons Row -->
        <LinearLayout
            android:id="@+id/row_medicine_buttons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:weightSum="2"
            app:layout_constraintTop_toBottomOf="@id/btn_trouble_breathing"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Rescue Inhaler BUTTON -->
            <Button
                android:id="@+id/btn_rescue_inhaler"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/dark_button_bg"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:text="💨\nRescue Inhaler"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:fontFamily="@font/codec_pro_regular" />

            <!-- Controller Medicine BUTTON -->
            <Button
                android:id="@+id/btn_controller_medicine"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/dark_button_bg"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:text="🫁\nController Medicine"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:fontFamily="@font/codec_pro_regular" />

        </LinearLayout>

        <!-- See All Achievements Button -->
        <Button
            android:id="@+id/btn_achievements"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="24dp"
            android:text="See All Achievements 🏆"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/achievements_background"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:fontFamily="@font/codec_pro_regular"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/row_medicine_buttons"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
