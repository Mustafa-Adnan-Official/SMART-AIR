<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- TOP BAR: logo + settings -->
    <LinearLayout
        android:id="@+id/topBarHistory"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#142144"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imageHistoryLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/triage_topbar_logo"
            android:contentDescription="SmartAir logo" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/buttonHistorySettings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:src="@drawable/settings"
            android:contentDescription="Settings" />
    </LinearLayout>

    <!-- NOTE AT BOTTOM -->
    <TextView
        android:id="@+id/textHistoryNote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:text="Note: Daily checkins can be shared from Parent settings to the Provider"
        android:textSize="11sp"
        android:textColor="#555555"
        android:fontFamily="@font/garet_book"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- MAIN CONTENT -->
    <ScrollView
        android:id="@+id/historyScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/topBarHistory"
        app:layout_constraintBottom_toTopOf="@id/textHistoryNote"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/historyContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TITLE ROW: calendar + 'History Browser' -->
            <LinearLayout
                android:id="@+id/historyTitleRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/imageHistoryCalendar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/calender_history"
                    android:contentDescription="History calendar" />

                <TextView
                    android:id="@+id/textHistoryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="History Browser"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:fontFamily="@font/garet_heavy" />
            </LinearLayout>

            <!-- SELECT FILTERS LABEL WITH LINES -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/history_divider" />

            <TextView
                android:id="@+id/textSelectFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="SELECT FILTERS"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#142144"
                android:gravity="center"
                android:fontFamily="@font/garet_heavy" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/history_divider" />

            <!-- HISTORY LIST (placeholder rows) -->
            <LinearLayout
                android:id="@+id/historyListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <!-- Example row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/textDateRow1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="DD/MM/YYYY"
                        android:textSize="16sp"
                        android:textColor="#000000"
                        android:fontFamily="@font/garet_book" />

                    <TextView
                        android:id="@+id/buttonViewDataRow1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VIEW DATA"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#142144"
                        android:fontFamily="@font/garet_heavy" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/history_divider" />

                <!-- Example row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/textDateRow2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="DD/MM/YYYY"
                        android:textSize="16sp"
                        android:textColor="#000000"
                        android:fontFamily="@font/garet_book" />

                    <TextView
                        android:id="@+id/buttonViewDataRow2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VIEW DATA"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#142144"
                        android:fontFamily="@font/garet_heavy" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/history_divider" />

                <!-- Example row 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/textDateRow3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="DD/MM/YYYY"
                        android:textSize="16sp"
                        android:textColor="#000000"
                        android:fontFamily="@font/garet_book" />

                    <TextView
                        android:id="@+id/buttonViewDataRow3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VIEW DATA"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#142144"
                        android:fontFamily="@font/garet_heavy" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/history_divider" />

                <!-- Example row 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/textDateRow4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="DD/MM/YYYY"
                        android:textSize="16sp"
                        android:textColor="#000000"
                        android:fontFamily="@font/garet_book" />

                    <TextView
                        android:id="@+id/buttonViewDataRow4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VIEW DATA"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#142144"
                        android:fontFamily="@font/garet_heavy" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/history_divider" />

                <!-- Example row 5 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/textDateRow5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="DD/MM/YYYY"
                        android:textSize="16sp"
                        android:textColor="#000000"
                        android:fontFamily="@font/garet_book" />

                    <TextView
                        android:id="@+id/buttonViewDataRow5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VIEW DATA"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#142144"
                        android:fontFamily="@font/garet_heavy" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/history_divider" />
            </LinearLayout>

            <!-- LOAD MORE BUTTON -->
            <Button
                android:id="@+id/buttonLoadMoreHistory"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:background="@drawable/dark_button_bg"
                android:text="LOAD MORE"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/garet_heavy" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
