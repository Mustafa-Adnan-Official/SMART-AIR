<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/outline_button">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Access Code:"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="@drawable/very_light_grey_bg"
        android:layout_marginBottom="20dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnCopyCode"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:srcCompat="@drawable/ic_copy"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:tint="#000000"/>

        <EditText
            android:id="@+id/accessCodeEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="F$14FS41"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="25sp"
            android:background="@null"
            android:inputType="textNoSuggestions"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:singleLine="true"/>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnRefreshCode"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:srcCompat="@drawable/ic_refresh"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:tint="#000000"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnManageChildren"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Manage Children"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:background="@drawable/dark_button_bg"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnManageProviders"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:backgroundTint="@null"
        android:text="Manage Providers"
        android:background="@drawable/dark_button_bg"
        android:backgroundTint="@null"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnSignOut"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Sign Out"
        android:background="@drawable/dark_button_bg"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:textColor="@color/white"
        android:textStyle="bold"/>
</LinearLayout>
