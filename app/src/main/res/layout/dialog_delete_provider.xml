<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/outline_button"
    >

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Delete Provider?"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:fontFamily="@font/codec_pro_regular"
        android:layout_marginBottom="16dp"
        android:gravity="center_horizontal"/>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/dialog_yesdeleteprovider_button"
            android:layout_width="0dp"
            android:layout_weight = "1"
            android:layout_marginEnd = "8dp"
            android:layout_height="40dp"
            android:text="Yes"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:background="@drawable/rounded_managedata_background"
            android:textColor="@color/white"
            android:fontFamily="@font/codec_pro_regular"
            />

        <Button
            android:id="@+id/dialog_nodeleteprovider_button"
            android:layout_width="0dp"
            android:layout_weight = "1"
            android:layout_height="40dp"
            android:background="@drawable/rounded_managedata_background"
            android:fontFamily="@font/codec_pro_regular"
            android:text="No"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:textColor="@color/white" />

    </LinearLayout>

</LinearLayout>