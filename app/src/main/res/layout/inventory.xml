<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:background="@drawable/outline_button">

    <LinearLayout
        android:id="@+id/inventoryTabs"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnController"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Controller"
            android:textColor="@color/text_selector"
            android:textStyle="bold"
            android:textSize="16sp"
            android:background="@drawable/button_selector_two"
            android:backgroundTint="@null"
            app:backgroundTint="@null"/>

        <Space
            android:layout_width="18dp"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnRescue"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Rescue"
            android:textColor="@color/text_selector"
            android:textStyle="bold"
            android:textSize="16sp"
            android:background="@drawable/button_selector_two"
            android:backgroundTint="@null"
            app:backgroundTint="@null"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/inventoryContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/inventoryTabs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/edittext_bg"
            android:padding="16dp"
            android:text="Purchase Date: 26/12/2024"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/expirationDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/edittext_bg"
            android:padding="16dp"
            android:paintFlags="underline"
            android:text="Expiration Date: 13/11/2027"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/edittext_bg"
            android:padding="16dp"
            android:text="Expected Daily Uses: 3"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:background="@drawable/edittext_bg"
            android:padding="16dp"
            android:text="Amount Left: 100%"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNewCanister"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:text="New Canister"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/dark_button_bg"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:layout_gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Warning: Creating a New Canister will replace current canister displayed information. Track only one canister per inventory type at a time!"
            android:textColor="#000000"
            android:textSize="16sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

