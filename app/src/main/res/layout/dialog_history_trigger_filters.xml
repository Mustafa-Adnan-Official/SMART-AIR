<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="24dp">

        <LinearLayout
            android:id="@+id/panelTriggerFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/history_filter_popup_bg"
            android:padding="16dp">

            <!-- Header -->
            <TextView
                android:id="@+id/textTriggerFiltersHeader"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/dark_button_bg"
                android:gravity="center"
                android:text="Trigger Filters"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/garet_heavy" />

            <!-- Each trigger row (same style) -->
            <!-- Dust Mites -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#E6E6E6"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/textTriggerDustMites"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dust Mites"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:fontFamily="@font/garet_book" />

                <Switch
                    android:id="@+id/switchDustMites"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/toggle_thumb"
                    android:track="@drawable/toggle_track" />
            </LinearLayout>

            <!-- Pets -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#E6E6E6"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/textTriggerPets"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pets"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:fontFamily="@font/garet_book" />

                <Switch
                    android:id="@+id/switchPets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/toggle_thumb"
                    android:track="@drawable/toggle_track" />
            </LinearLayout>

            <!-- Smoke -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#E6E6E6"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/textTriggerSmoke"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Smoke"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:fontFamily="@font/garet_book" />

                <Switch
                    android:id="@+id/switchSmoke"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/toggle_thumb"
                    android:track="@drawable/toggle_track" />
            </LinearLayout>

            <!-- Strong Odors/Perfumes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#E6E6E6"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/textTriggerOdors"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Strong Odors/Perfumes"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:fontFamily="@font/garet_book" />

                <Switch
                    android:id="@+id/switchOdors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/toggle_thumb"
                    android:track="@drawable/toggle_track" />
            </LinearLayout>

            <!-- Cold Air -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#E6E6E6"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/textTriggerColdAir"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cold Air"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:fontFamily="@font/garet_book" />

                <Switch
                    android:id="@+id/switchColdAir"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/toggle_thumb"
                    android:track="@drawable/toggle_track" />
            </LinearLayout>

            <!-- Illness -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#E6E6E6"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/textTriggerIllness"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Illness"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:fontFamily="@font/garet_book" />

                <Switch
                    android:id="@+id/switchIllness"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/toggle_thumb"
                    android:track="@drawable/toggle_track" />
            </LinearLayout>

            <!-- Exercise -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#E6E6E6"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/textTriggerExercise"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Exercise"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:fontFamily="@font/garet_book" />

                <Switch
                    android:id="@+id/switchExercise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/toggle_thumb"
                    android:track="@drawable/toggle_track" />
            </LinearLayout>

            <!-- Bottom buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/buttonTriggerSubmit"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/dark_button_bg"
                    android:text="Submit"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/garet_book" />

                <Button
                    android:id="@+id/buttonTriggerBack"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/dark_button_bg"
                    android:text="Back"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/garet_book" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
