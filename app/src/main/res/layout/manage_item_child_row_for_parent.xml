<?xml version="1.0" encoding="utf-8"?>



<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical ="40dp"
    android:layout_marginHorizontal="20dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#9d9d9d"

    >


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/rounded_titletag_background"
            android:padding="10dp"



            >


            <TextView
                android:id="@+id/child_name_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Child 1"
                android:textStyle = "bold"
                android:textSize="20sp"
                android:textColor="#000000"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily = "@font/garet_book"
                />

            <ImageButton
                android:id="@+id/delete_child_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/delete"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@android:color/transparent"
                android:contentDescription="@string/cd_delete_child" />


        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height = "1dp"
            android:background = "@android:color/darker_gray"
            android:layout_marginBottom = "12dp"

            />

        <LinearLayout
            android:layout_width = "match_parent"
            android:layout_height = "wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom = "12dp"
            android:padding="9dp"
            android:background = "@drawable/rounded_settings_background"

            >

            <TextView
                android:id="@+id/pb_setting_textview"
                android:layout_width = "0dp"
                android:layout_height = "wrap_content"
                android:layout_weight="1"
                android:text = "PB Setting: 500"
                android:textSize="19sp"
                android:layout_centerVertical="true"
                android:fontFamily = "@font/codec_pro_regular"

                />


            <ImageButton
                android:id="@+id/pb_setting_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/pencil"
                android:layout_centerVertical="true"
                android:background="@android:color/transparent"
                android:contentDescription="@string/cd_edit_pb_setting" />


        </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation = "vertical"
        android:layout_marginBottom="10dp"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text = "Zone Thresholds Are: "
            android:textSize = "15sp"

            />

        <TextView
            android:id = "@+id/zone_threshold_green_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text = "• Green ≥ 80% PB = 400"
            android:textSize = "15sp"

            />

        <TextView
            android:id = "@+id/zone_threshold_yellow_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text = "• Yellow 50-79% PB = 250 to 395"
            android:textSize = "15sp" />

        <TextView
            android:id = "@+id/zone_threshold_red_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text = "• Red 50% PB = 250"
            android:textSize = "15sp" />

    </LinearLayout>


    <Button
        android:id="@+id/manage_inventory_button"
        android:layout_width = "match_parent"
        android:layout_height = "wrap_content"
        android:layout_weight="1"
        android:textAlignment="center"
        android:textColor = "@color/white"
        android:padding = "8dp"
        android:background = "@drawable/dark_button_bg"
        android:text = "Manage Inventory"
        android:textSize="18sp"
        android:fontFamily = "@font/codec_pro_regular"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        />







    </LinearLayout>








</androidx.cardview.widget.CardView>
