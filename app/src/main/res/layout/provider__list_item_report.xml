<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/date_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DD/MM/YYYY"
        android:textColor="@android:color/black"
        app:layout_constraintBaseline_toBaselineOf="@id/report_type_textview"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/report_type_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="[REPORT]"
        android:textColor="#0A355F"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/date_textview"
        app:layout_constraintEnd_toStartOf="@id/csv_button"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/csv_button"
        android:layout_width="wrap_content"
        android:layout_height="37dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/outline_button"
        android:backgroundTint="@null"
        android:text="CSV"
        app:backgroundTint="@null"
        android:textColor="#0A355F"
        android:textSize="12sp"
        android:textStyle="bold"
        android:minWidth="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBaseline_toBaselineOf="@id/report_type_textview"
        app:layout_constraintEnd_toStartOf="@id/pdf_button" />

    <Button
        android:id="@+id/pdf_button"
        android:layout_width="wrap_content"
        android:layout_height="37dp"
        android:background="@drawable/outline_button"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:text="PDF"
        android:textColor="#0A355F"
        android:textSize="12sp"
        android:textStyle="bold"
        android:minWidth="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBaseline_toBaselineOf="@id/report_type_textview"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/black"
        app:layout_constraintTop_toBottomOf="@id/report_type_textview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
