<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/date_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DD/MM/YYYY"
        android:textColor="@android:color/black"
        app:layout_constraintBaseline_toBaselineOf="@+id/report_type_textview"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/report_type_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="[REPORT]"
        android:textColor="#0A355F"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/csv_textview"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/date_textview"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/csv_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="CSV"
        android:textColor="#0A355F"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@+id/report_type_textview"
        app:layout_constraintEnd_toStartOf="@+id/pdf_textview" />

    <TextView
        android:id="@+id/pdf_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PDF"
        android:textColor="#0A355F"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@+id/report_type_textview"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/report_type_textview" />

</androidx.constraintlayout.widget.ConstraintLayout>