<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- TOP BAR WITH LOGO -->
    <ImageView
        android:id="@+id/triageTopBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#142144"
        android:scaleType="fitCenter"
        android:src="@drawable/smartair_official2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/cardFinal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/triage_card_bg"
        android:padding="16dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/triageTopBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/textTriageLabelFinal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TRIAGE SUMMARY — tell us how you feel."
            android:textColor="#D42828"
            android:textStyle="bold"
            android:textSize="14sp"
            android:gravity="center"
            android:fontFamily="@font/garet_heavy"
            android:layout_marginBottom="12dp" />

        <!-- BEFORE -->
        <TextView
            android:id="@+id/textBeforeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How do you feel before ?"
            android:textAlignment="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:fontFamily="@font/garet_heavy"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnGood"
                android:layout_width="105dp"
                android:layout_height="40dp"
                android:background="@drawable/button_selector"
                android:backgroundTint="@null"
                android:text="🙂 Good"
                android:textColor="@color/text_selector"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/codec_pro_fixed"
                app:backgroundTint="@null" />

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnOkay"
                android:layout_width="105dp"
                android:layout_height="40dp"
                android:fontFamily="@font/codec_pro_fixed"
                android:text="😐 Okay"
                android:textStyle="bold"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:textSize="14sp"
                android:textColor="@color/text_selector"
                android:background="@drawable/button_selector" />

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnBad"
                android:layout_width="105dp"
                android:fontFamily="@font/codec_pro_fixed"
                android:layout_height="40dp"
                android:text="😟 Bad"
                android:textStyle="bold"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:textSize="14sp"
                android:textColor="@color/text_selector"
                android:background="@drawable/button_selector"/>
        </LinearLayout>

        <!-- NOW -->
        <TextView
            android:id="@+id/textNowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="How do you feel now?"
            android:textAlignment="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:fontFamily="@font/garet_heavy"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnNowBetter"
                android:layout_width="100dp"
                android:fontFamily="@font/codec_pro_fixed"
                android:layout_height="40dp"
                android:text="🙂 Better"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="@color/text_selector"
                android:background="@drawable/button_selector" />

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnNowSame"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:text="😐 Same"
                android:fontFamily="@font/codec_pro_fixed"
                android:textStyle="bold"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:textSize="11sp"
                android:textColor="@color/text_selector"
                android:background="@drawable/button_selector" />

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnNowWorse"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:text="😟 Worse"
                android:fontFamily="@font/codec_pro_fixed"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="@color/text_selector"
                android:background="@drawable/button_selector" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonDone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/dark_button_bg"
            android:text="DONE"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/garet_heavy"/>

        <TextView
            android:id="@+id/textDoneSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="MAKE SURE TO AVOID TRIGGER ACTIVITIES"
            android:textAlignment="center"
            android:textSize="11sp"
            android:textColor="#000000"
            android:fontFamily="@font/garet_book"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
