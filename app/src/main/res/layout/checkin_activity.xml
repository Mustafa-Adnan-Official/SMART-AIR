<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id = "@+id/banner_title"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">



    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"


        >

        <ImageView
            android:id="@+id/logoSmartAir"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#142144"
            android:src="@drawable/smartair_official2"
            android:scaleType="centerCrop"
/>

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"

            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/codec_pro_regular"
                android:text="How Are You Feeling?"
                android:textColor="@color/black"
                android:textSize="20dp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/checkin_feeling_great_button"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/button_selector"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:fontFamily="@font/codec_pro_regular"
                    android:textColor="@color/text_selector"
                    android:text="Great"
                    android:textSize="20dp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/checkin_feeling_okay_button"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/button_selector"
                    android:textColor="@color/text_selector"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:fontFamily="@font/codec_pro_regular"
                    android:text="Okay"


                    android:textSize="20dp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/checkin_feeling_bad_button"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/button_selector"
                    android:textColor="@color/text_selector"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:fontFamily="@font/codec_pro_regular"
                    android:text="Bad"

                    android:textSize="20dp"
                    android:textStyle="bold" />


            </LinearLayout>

        </LinearLayout>

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp"

            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/codec_pro_regular"
                android:text="Symptoms?"
                android:textColor="@color/black"
                android:textSize="20dp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/codec_pro_regular"
                android:text="Select all that apply"
                android:textColor="@color/black"
                android:textSize="10sp"
                android:textStyle="bold" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/symptom_night_waking_button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/button_selector"
                    android:textColor="@color/text_selector"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:fontFamily="@font/codec_pro_regular"
                    android:text="🌙 Night Waking"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_margin="4dp"
                    />

                <Button
                    android:id="@+id/symptom_cough_wheeze_button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/codec_pro_regular"
                    android:text="😮‍💨Cough/Wheeze"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/button_selector"
                    android:textColor="@color/text_selector"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:layout_margin="4dp"
                    />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom = "13dp"
                >

                <Button
                    android:id="@+id/symptom_activity_difficulty_button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/button_selector"
                    android:textColor="@color/text_selector"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:fontFamily="@font/codec_pro_regular"
                    android:text="🏃‍♂️‍➡️Activity Difficulty"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_margin="4dp"
                    />

                <Button
                    android:id="@+id/symptom_shortness_breath_button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/button_selector"
                    android:textColor="@color/text_selector"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:fontFamily="@font/codec_pro_regular"
                    android:text="🫁Shortness of Breath"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_margin="4dp"
                    />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/symptoms_input_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Other: "
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:background = "@drawable/outline_button_bg"

                >

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/symptoms_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLength="4"
                    android:textStyle="bold"
                    android:fontFamily="@font/codec_pro_regular"/>

            </com.google.android.material.textfield.TextInputLayout>


        </LinearLayout>

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"

            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/codec_pro_regular"
                android:text="Triggers?"
                android:textColor="@color/black"
                android:textSize="20dp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/codec_pro_regular"
                android:text="Select all that apply"
                android:textColor="@color/black"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/trigger_cold_air_button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/codec_pro_regular"
                    android:text="❄️Cold Air"
                    android:background="@drawable/button_selector"
                    android:textColor="@color/text_selector"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_margin="4dp"
                    />

                <Button
                    android:id="@+id/trigger_dust_button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/codec_pro_regular"
                    android:text="🧹Dust"
                    android:background="@drawable/button_selector"
                    android:textColor="@color/text_selector"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_margin="4dp"
                    />


                <Button
                    android:id="@+id/trigger_exercise_button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/codec_pro_regular"
                    android:text="🏋️‍♀️Exercise"
                    android:background="@drawable/button_selector"
                    android:textColor="@color/text_selector"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_margin="4dp"
                    />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/trigger_pets_button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/codec_pro_regular"
                    android:text="🐶Pets"
                    android:background="@drawable/button_selector"
                    android:textColor="@color/text_selector"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_margin="4dp"
                    />

                <Button
                    android:id="@+id/trigger_illness_button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/codec_pro_regular"
                    android:text="🤧Illness"
                    android:background="@drawable/button_selector"
                    android:textColor="@color/text_selector"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_margin="4dp"
                    />

                <Button
                    android:id="@+id/trigger_smoke_button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/codec_pro_regular"
                    android:text="🚬Smoke"
                    android:background="@drawable/button_selector"
                    android:textColor="@color/text_selector"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_margin="4dp"
                    />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/trigger_input_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Other Triggers: "
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:background = "@drawable/outline_button_bg"

                >

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/trigger_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLength="4"
                    android:textStyle="bold"
                    android:fontFamily="@font/codec_pro_regular"/>

            </com.google.android.material.textfield.TextInputLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation = "vertical"
            android:padding="10dp"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/codec_pro_regular"
                android:text="Peak Flow Reading"
                android:textColor="@color/black"
                android:textSize="20dp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"
                />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation = "horizontal"
                android:gravity ="center_vertical"
                android:layout_marginBottom="15dp"
                android:paddingHorizontal="20dp"
                >
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/peakflow_input_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:hint="Enter Value"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:background = "@drawable/outline_button_bg"
    
                    >
    
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/peakflow_edit_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:focusable="true"
                        android:clickable="true"
                        android:textStyle="bold"
                        android:fontFamily="@font/codec_pro_regular"/>
    
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/codec_pro_regular"
                    android:text="Liters/min"
                    android:textColor="@color/black"
                    android:textSize="20dp"
                    android:textStyle="bold" />
                
                
            </LinearLayout>
        
        
        
        </LinearLayout>
            
        <Button
            android:id="@+id/checkin_save_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text = "Save Check-In"
            android:fontFamily = "@font/codec_pro_regular"
            android:background="@drawable/dark_button_bg"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:layout_marginHorizontal="30dp"
            android:textSize = "20dp"
            />
        
    </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>