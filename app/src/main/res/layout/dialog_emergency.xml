<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000">   <!-- semi-transparent dim background -->

    <!-- The navy popup card -->
    <LinearLayout
        android:id="@+id/panelEmergency"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/triage_emergency_panel_bg"
        android:padding="24dp"
        android:layout_margin="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/textEmergencyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PLEASE CALL EMERGENCY\nIMMEDIATELY"
            android:textAlignment="center"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/garet_heavy"/>

        <Button
            android:id="@+id/buttonCloseEmergency"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="24dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/triage_button_outline"
            android:text="CLOSE"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/garet_book"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
