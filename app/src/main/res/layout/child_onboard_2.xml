<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/demologo"
        android:adjustViewBounds="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Medicine Types"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#428CE4"
        app:layout_constraintTop_toBottomOf="@id/logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"/>

    <TextView
        android:id="@+id/desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="• Rescue inhaler: Quick-relief medicine for sudden symptoms."
        android:textSize="20sp"
        android:textColor="#444444"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/desc_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="• Controller medicine: Daily prevention medicine that keeps your airways calm.
SmartAir helps you log both so you can stay safe and understand your patterns."
        android:textSize="20sp"
        android:textColor="#444444"
        android:paddingStart ="24dp"
        android:paddingBottom ="24dp"
        app:layout_constraintTop_toBottomOf="@id/desc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/desc_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="SmartAir helps you log both so you can stay safe and understand your patterns."
        android:textSize="20sp"
        android:textColor="#444444"
        android:paddingStart ="24dp"
        android:paddingBottom ="24dp"
        app:layout_constraintTop_toBottomOf="@id/desc_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btn_next"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Next"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/dark_button_bg"
        app:layout_constraintTop_toBottomOf="@id/desc_3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="32dp"
        android:backgroundTint="@null"
        android:textSize="20sp"
        app:backgroundTint="@null"/>

</androidx.constraintlayout.widget.ConstraintLayout>
