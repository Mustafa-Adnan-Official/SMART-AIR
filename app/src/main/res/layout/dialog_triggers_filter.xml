<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/outline_button"
    android:padding="20dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sort by Triggers"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:fontFamily="@font/codec_pro_regular"
        android:layout_marginBottom="16dp"
        android:gravity="center_horizontal"/>

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"

        >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/codec_pro_regular"
            android:text="Triggers?"
            android:textColor="@color/black"
            android:textSize="20dp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/trigger_cold_air_button"
                android:layout_width="250dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/codec_pro_regular"
                android:text="❄️Cold Air"
                android:backgroundTint="@null"
                android:layout_marginEnd="20dp"
                app:backgroundTint="@null"
                android:textColor="@color/text_selector"
                android:background="@drawable/button_selector"
                android:textSize="15dp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/trigger_dust_button"
                android:layout_width="250dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/codec_pro_regular"
                android:text="🧹Dust"
                android:backgroundTint="@null"
                android:layout_marginEnd="20dp"
                app:backgroundTint="@null"
                android:textColor="@color/text_selector"
                android:background="@drawable/button_selector"
                android:textSize="15dp"
                android:textStyle="bold" />


            <Button
                android:id="@+id/trigger_exercise_button"
                android:layout_width="250dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/codec_pro_regular"
                android:text="🏋️‍♀️Exercise"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:textColor="@color/text_selector"
                android:background="@drawable/button_selector"
                android:textSize="15dp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/trigger_pets_button"
                android:layout_width="250dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/codec_pro_regular"
                android:text="🐶Pets"
                android:backgroundTint="@null"
                android:layout_marginEnd="20dp"
                app:backgroundTint="@null"
                android:textColor="@color/text_selector"
                android:background="@drawable/button_selector"
                android:textSize="15dp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/trigger_illness_button"
                android:layout_width="250dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/codec_pro_regular"
                android:text="🤧Illness"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:layout_marginEnd="20dp"
                android:textColor="@color/text_selector"
                android:background="@drawable/button_selector"
                android:textSize="15dp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/trigger_smoke_button"
                android:layout_width="250dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/codec_pro_regular"
                android:text="🚬Smoke"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:textColor="@color/text_selector"
                android:background="@drawable/button_selector"
                android:textSize="15dp"
                android:textStyle="bold" />
        </LinearLayout>


    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/dialog_confirmtriggers_sort_button"
            android:layout_width="0dp"
            android:layout_weight = "1"
            android:layout_marginEnd = "8dp"
            android:layout_height="40dp"
            android:text="Confirm"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:background="@drawable/rounded_managedata_background"
            android:textColor="@color/white"
            android:fontFamily="@font/codec_pro_regular"
            />

        <Button
            android:id="@+id/dialog_notriggers_sort_button"
            android:layout_width="0dp"
            android:layout_weight = "1"
            android:layout_height="40dp"
            android:background="@drawable/rounded_managedata_background"
            android:fontFamily="@font/codec_pro_regular"
            android:text="Exit"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:textColor="@color/white" />



    </LinearLayout>
</LinearLayout>