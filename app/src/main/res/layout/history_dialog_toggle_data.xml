<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/outline_button"
    >

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Data Toggles"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:fontFamily="@font/codec_pro_regular"
        android:layout_marginBottom="16dp"
        android:gravity="center_horizontal"
        android:background = "@drawable/dark_button_bg"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        >

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/codec_pro_fixed"
            android:text="Rescue Logs"
            android:textColor="#000000"
            android:textSize="17sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id = "@+id/toggle_rescuelog_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_colors"
            app:trackTint="@color/switch_track_colors"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        >

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Controller Adherence Summary"
            android:textSize="17sp"
            android:fontFamily="@font/codec_pro_fixed"
            android:textStyle="bold"
            android:textColor="#000000"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id = "@+id/toggle_symptoms_tracking"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_colors"
            app:trackTint="@color/switch_track_colors"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        >

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Symptoms"
            android:fontFamily="@font/codec_pro_fixed"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#000000"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id = "@+id/toggle_triggers_tracking"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_colors"
            app:trackTint="@color/switch_track_colors"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        >

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/codec_pro_fixed"
            android:layout_weight="1"
            android:text="Triggers"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#000000"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id = "@+id/toggle_peakflow_tracking"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_colors"
            app:trackTint="@color/switch_track_colors"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        >

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/codec_pro_fixed"
            android:layout_weight="1"
            android:text="Peak-Flow (PEF)"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#000000"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id = "@+id/toggle_triageincidents_tracking"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_colors"
            app:trackTint="@color/switch_track_colors"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        >

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Triage Incidents"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="@font/codec_pro_fixed"
            android:textColor="#000000"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id = "@+id/toggle_summarycharts_tracking"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_colors"
            app:trackTint="@color/switch_track_colors"/>
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"

        >
        <Button
            android:id="@+id/dialog_next_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Next"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:background="@drawable/rounded_managedata_background"
            android:textColor="@color/white"
            android:fontFamily="@font/codec_pro_regular"
            android:layout_weight="1"
            android:layout_marginRight = "20dp"
            />

        <Button
            android:id="@+id/dialog_close_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Close"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:background="@drawable/rounded_managedata_background"
            android:textColor="@color/white"
            android:fontFamily="@font/codec_pro_regular"
            android:layout_weight="1"
            android:layout_marginLeft = "20dp"

            />
    </LinearLayout>

</LinearLayout>